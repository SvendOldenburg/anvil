# Copy to tools/.env and fill in. Never commit tools/.env.
PB_URL=https://pb.aetheriumforge.cloud

# PocketBase superuser -- needed to change collection rules.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# The shared `users` account the app logs in with. Used by verify_access.py
# to prove an authenticated read still works after the lockdown.
ANVIL_USER_EMAIL=
ANVIL_USER_PASSWORD=
